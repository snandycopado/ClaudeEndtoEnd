{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(sf project delete:*)",
      "Bash(sf org delete:*)",
      "Bash(sf org logout:*)",
      "Bash(sf org login:*)",
      "Bash(sf data delete:*)",
      "Bash(sf data update:*)",
      "Bash(sf package uninstall:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Edit(sfdx-project.json)",
      "Write(sfdx-project.json)",
      "Edit(.forceignore)",
      "Write(.forceignore)",
      "Edit(manifest/destructiveChanges*.xml)",
      "Write(manifest/destructiveChanges*.xml)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Read(.env*)",
      "Read(**/*.key)",
      "Read(**/auth*.json)"
    ],
    "ask": [
      "Bash(sf project deploy start:*)",
      "Bash(sf project deploy validate:*)",
      "Bash(sf apex run --file:*)",
      "Bash(sf org assign:*)",
      "Bash(sf data create:*)",
      "Bash(sf data import:*)",
      "Bash(sf data upsert:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(node .claude/skills/sf-deploy/deploy.mjs:*)",
      "mcp__salesforce"
    ],
    "allow": [
      "Bash(sf project deploy start --dry-run:*)",
      "Bash(sf apex run test:*)",
      "Bash(sf apex get test:*)",
      "Bash(sf project deploy report:*)",
      "Bash(sf code-analyzer run:*)",
      "Bash(sf data query:*)",
      "Bash(sf org display:*)",
      "Bash(sf org list:*)",
      "Bash(node .claude/hooks/tests/run-guard-tests.mjs)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-sf-command.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-files.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-save.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
