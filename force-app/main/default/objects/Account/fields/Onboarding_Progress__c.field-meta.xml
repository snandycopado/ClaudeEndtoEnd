<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Onboarding_Progress__c</fullName>
    <description>Completed onboarding tasks as a percentage of all onboarding tasks.</description>
    <formula>IF(Onboarding_Tasks_Total__c = 0, 0, Onboarding_Tasks_Completed__c / Onboarding_Tasks_Total__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Onboarding Progress</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
